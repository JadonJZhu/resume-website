---
// Projects component - contains the projects showcase section.
//
// There is ONE list of projects: the JSON files under src/content/projects/,
// typed by src/content.config.ts. Adding a project means adding one file there
// and touching nothing in this component. Until 2026-09-05 this file held four
// lists of projects that had to stay in sync, and they had already drifted.
import { getCollection, type CollectionEntry } from 'astro:content';
import { hoverContent } from '../lib/hover-content.ts';
import { projectLinks } from '../lib/project-links.ts';

type ProjectData = CollectionEntry<'projects'>['data'];

// An entry without `order` sorts last and `id` breaks the tie, which keeps the
// sort total and stable however incomplete the data is.
const SORTS_LAST = Number.MAX_SAFE_INTEGER;
const entries = (await getCollection('projects')).sort(
	(a, b) =>
		(a.data.order ?? SORTS_LAST) - (b.data.order ?? SORTS_LAST) || a.id.localeCompare(b.id),
);

// The scrim text is built here rather than by the client script that used to
// assemble it, which removes the flash where the scrim was blank until the
// script ran. Every segment is escaped for CSS; see src/lib/hover-content.ts
// for what each unescaped character did.
const scrim = (data: ProjectData): string => `--hover-content: ${hoverContent(data)}`;

// Only what the modal reads, keyed by slug. The card carries the same slug in
// data-slug, so there is no class-name lookup table to keep in sync.
const modalData = Object.fromEntries(
	entries.map((entry) => [
		entry.id,
		{
			title: entry.data.title,
			period: entry.data.period,
			blurb: entry.data.blurb,
			legacyHtmlBlurb: entry.data.legacyHtmlBlurb,
			skills: entry.data.skills,
			// Already reduced to an ordered array here, so the client script
			// holds no knowledge of which link keys exist. A new key is a line
			// in src/lib/project-links.ts and nothing in this file.
			links: projectLinks(entry.data.links),
			image: entry.data.hero.poster,
		},
	]),
);
---

<section class="projects">
	<div class="projects-grid">
		{
			entries.map((entry) => (
				<div
					class="project-card project-with-image"
					data-slug={entry.id}
					style={scrim(entry.data)}
				>
					{/* Both formats are <source> children and the <video> carries
					    no `src`: a <video src=...> makes its <source> children
					    unreachable, so the webm would never be chosen. */}
					{entry.data.hero.video ? (
						<video autoplay muted loop playsinline poster={entry.data.hero.poster}>
							{entry.data.hero.webm && (
								<source src={entry.data.hero.webm} type="video/webm" />
							)}
							<source src={entry.data.hero.video} type="video/mp4" />
						</video>
					) : (
						<img
							src={entry.data.hero.poster}
							alt={entry.data.hero.alt ?? `${entry.data.title} Project`}
						/>
					)}
				</div>
			))
		}
	</div>
</section>

<!-- Project Modal -->
<div id="project-modal" class="project-modal">
	<div class="modal-content">
		<span class="close-button">&times;</span>
		<div class="modal-header">
			<h3 id="modal-title"></h3>
			<span id="modal-year" class="project-year"></span>
		</div>
		<div class="modal-image-container">
			<img id="modal-image" src="" alt="Project Cover" />
		</div>
		<div class="modal-body">
			<p id="modal-description"></p>
			{/* Empty and `hidden` until a project with links opens. Most
			    projects have none, and for those this element must occupy no
			    space and add no separator. */}
			<p id="modal-links" class="project-links" hidden></p>
			<div class="skills">
				<h4>Skills Used:</h4>
				<div id="modal-skills" class="skill-tags"></div>
			</div>
		</div>
	</div>
</div>

<script define:vars={{ modalData }}>
	document.addEventListener('DOMContentLoaded', () => {
		const modal = document.getElementById('project-modal');
		const modalImage = document.getElementById('modal-image');
		const modalTitle = document.getElementById('modal-title');
		const modalYear = document.getElementById('modal-year');
		const modalDescription = document.getElementById('modal-description');
		const modalSkills = document.getElementById('modal-skills');
		const modalLinks = document.getElementById('modal-links');
		const closeButton = document.querySelector('.close-button');

		// Function to open modal with project data
		function openModal(slug) {
			const project = modalData[slug];
			if (project && modal && modalImage && modalTitle && modalYear && modalDescription && modalSkills) {
				modalImage.src = project.image || '';
				modalImage.alt = `${project.title} cover image`;
				modalTitle.textContent = project.title;
				modalYear.textContent = project.period;

				// A blurb written by the publish contract is plain text and the
				// generator has no reason to escape it, so it is inserted as text.
				// Only the three projects that predate the contract carry
				// hand-written HTML with inline anchors, and they declare that in
				// their own JSON rather than have it guessed from the string.
				if (project.legacyHtmlBlurb) {
					modalDescription.innerHTML = project.blurb;
				} else {
					modalDescription.textContent = project.blurb;
				}

				// Clear and populate skills
				modalSkills.innerHTML = '';
				project.skills.forEach(skill => {
					const skillTag = document.createElement('span');
					skillTag.className = 'skill-tag';
					skillTag.textContent = skill;
					modalSkills.appendChild(skillTag);
				});

				// Links. `hidden` when there are none, so a link-less project
				// renders the modal exactly as it did before links existed.
				// Anchors are built as elements and the label is set as text,
				// so nothing in the project data can become markup.
				if (modalLinks) {
					modalLinks.innerHTML = '';
					const links = project.links || [];
					links.forEach(link => {
						const anchor = document.createElement('a');
						anchor.href = link.url;
						// The same treatment the hand-written blurb anchors use.
						anchor.target = '_blank';
						anchor.rel = 'noopener noreferrer';
						anchor.textContent = link.label;
						modalLinks.appendChild(anchor);
					});
					modalLinks.hidden = links.length === 0;
				}

				modal.style.display = 'block';
				document.body.style.overflow = 'hidden'; // Prevent background scrolling
			}
		}

		// Function to close modal
		function closeModal() {
			if (modal) {
				modal.style.display = 'none';
				document.body.style.overflow = 'auto'; // Restore scrolling
			}
		}

		// Add click event listeners to project cards. Each card carries its own
		// slug, so nothing here has to know a project exists.
		document.querySelectorAll('.project-card').forEach(card => {
			const slug = card.dataset.slug;
			if (slug && modalData[slug]) {
				card.addEventListener('click', () => openModal(slug));
			}
		});

		// Close modal when clicking the close button
		if (closeButton) {
			closeButton.addEventListener('click', closeModal);
		}

		// Close modal when clicking outside the modal content
		if (modal) {
			modal.addEventListener('click', e => {
				if (e.target === modal) {
					closeModal();
				}
			});
		}

		// Close modal on Escape key
		document.addEventListener('keydown', e => {
			if (e.key === 'Escape' && modal && modal.style.display === 'block') {
				closeModal();
			}
		});
	});
</script>

<style>
	.projects {
		padding: 1rem 2rem;
		background-color: var(--beige);
		min-height: 40vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.projects hr {
		border: none;
		height: 2px;
		background-color: var(--text-dark);
		margin-bottom: 3rem;
		width: 60%;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;

		width: 90%;
		max-width: 800px;
	}

	.project-card {
		background-color: var(--soft-yellow);
		border-radius: 12px;
		padding: 2rem;
		text-align: center;
		cursor: pointer;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		border: 2px solid transparent;
		min-height: 400px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		position: relative;
	}

	.project-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
		border-color: var(--text-muted);
	}

	.project-with-image {
		padding: 0;
		position: relative;
		aspect-ratio: 5 / 3;
	}

	.project-with-image :is(img, video) {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 10px;
	}

	.project-with-image::after {
		content: var(--hover-content);
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.5);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		color: white;
		font-size: 1.2rem;
		font-weight: 400;
		text-align: center;
		white-space: pre-line;
		border-radius: 10px;
		z-index: 1;
	}

	.project-with-image::after::first-line {
		font-weight: 600;
	}

	.project-card h3 {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--text-dark);
		margin: 0 0 0.5rem 0;
	}

	.project-card p {
		color: var(--text-muted);
		margin: 0;
		font-size: 0.9rem;
	}

	@media (max-width: 768px) {
		.projects {
			padding: 2rem 1rem;
			min-height: auto;
		}

		.projects hr {
			margin-bottom: 2rem;
		}

		.projects-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
			width: 95%;
		}

		.project-card {
			padding: 2rem;
			min-height: 350px;
		}
	}

/* Modal Styles */
.project-modal {
	display: none;
	position: fixed;
	z-index: 1000;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: rgba(0, 0, 0, 0.8);
	backdrop-filter: blur(5px);
}

.modal-content {
	background-color: var(--soft-yellow);
	margin: 5% auto;
	padding: 0;
	width: 90%;
	max-width: 700px;
	border-radius: 15px;
	box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
	animation: modalFadeIn 0.3s ease-out;
	position: relative;
}

@keyframes modalFadeIn {
	from {
		opacity: 0;
		transform: scale(0.9) translateY(-20px);
	}
	to {
		opacity: 1;
		transform: scale(1) translateY(0);
	}
}

.close-button {
	color: var(--text-dark);
	position: absolute;
	top: 15px;
	right: 20px;
	font-size: 28px;
	font-weight: bold;
	cursor: pointer;
	transition: color 0.2s ease;
	z-index: 1001;
}

.close-button:hover {
	color: var(--text-muted);
}

.modal-header {
	padding: 2rem 2rem 1rem 2rem;
	border-bottom: 1px solid var(--text-muted);
	display: flex;
	justify-content: space-between;
	align-items: center;
	flex-wrap: wrap;
	gap: 0.5rem;
}

.modal-header h3 {
	font-size: 1.8rem;
	font-weight: 700;
	color: var(--text-dark);
	margin: 0;
	flex: 1;
}

.project-year {
	font-size: 1rem;
	color: var(--text-muted);
	font-weight: 500;
	background-color: var(--beige);
	padding: 0.25rem 0.75rem;
	border-radius: 20px;
	white-space: nowrap;
}

.modal-image-container {
	padding: 0 2rem 1rem 2rem;
	display: flex;
	justify-content: center;
}

.modal-image-container img {
	width: 100%;
	max-width: 500px;
	height: auto;
	border-radius: 10px;
	box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
}

.modal-body {
	padding: 2rem;
}

.modal-body p {
	font-size: 1.1rem;
	line-height: 1.6;
	color: var(--text-dark);
	margin-bottom: 2rem;
}

.modal-body p a {
	color: var(--text-dark);
	text-decoration: underline;
	font-weight: 600;
	transition: color 0.2s ease;
}

.modal-body p a:hover {
	color: var(--text-muted);
}

/* Layout only, and deliberately no colour or weight of its own. The row is a
   <p> inside .modal-body, so the anchor rules above are written to cover it and
   nothing here has to restate them.

   Those rules do not reach it TODAY, and that is a pre-existing bug rather than
   anything about links. Astro scopes every selector by appending
   `[data-astro-cid-amng4zvp]`, and an element the client script creates carries
   no such attribute, so `.modal-body p a` and `.skill-tag` both miss every
   element in this modal. Measured 2026-09-05 in headless Chrome: the itch.io
   anchor inside a legacy blurb computes `rgb(0, 0, 238)` at weight 400, and a
   skill tag computes no background, no border and no padding. A new link
   therefore renders exactly like the anchors already beside it, which is the
   point. Fixing the scoping is its own change, tracked in PLAN.md §4 Step 2b,
   and it will pick this row up with no edit here.

   `.project-links` itself is in the markup, so it does carry the attribute and
   these two rules do apply. The `[hidden]` rule is not optional: `display:
   flex` beats the UA `[hidden] { display: none }` and the row would show as an
   empty gap on every project that has no links. */
.project-links {
	display: flex;
	flex-wrap: wrap;
	gap: 1.25rem;
}

.project-links[hidden] {
	display: none;
}

.skills h4 {
	font-size: 1.2rem;
	font-weight: 600;
	color: var(--text-dark);
	margin-bottom: 1rem;
	margin-top: 0;
}

.skill-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem;
}

.skill-tag {
	background-color: var(--beige);
	color: var(--text-dark);
	padding: 0.5rem 1rem;
	border-radius: 25px;
	font-size: 0.9rem;
	font-weight: 500;
	border: 1px solid var(--text-muted);
	transition: all 0.2s ease;
}

.skill-tag:hover {
	background-color: var(--text-muted);
	color: white;
	transform: translateY(-1px);
}

/* Modal Responsive Design */
@media (max-width: 768px) {
	.modal-content {
		margin: 2% auto;
		width: 95%;
	}

	.modal-header {
		padding: 1.5rem 1.5rem 1rem 1.5rem;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.modal-header h3 {
		font-size: 1.5rem;
	}

	.modal-image-container {
		padding: 0 1.5rem 1rem 1.5rem;
	}

	.modal-image-container img {
		max-width: 100%;
	}

	.modal-body {
		padding: 1.5rem;
	}

	.modal-body p {
		font-size: 1rem;
		margin-bottom: 1.5rem;
	}

	.skills h4 {
		font-size: 1.1rem;
		margin-bottom: 0.75rem;
	}

	.skill-tags {
		gap: 0.4rem;
	}

	.skill-tag {
		padding: 0.4rem 0.8rem;
		font-size: 0.8rem;
	}
}
</style>
